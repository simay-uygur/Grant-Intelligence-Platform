# Copy to .env.local and adjust as needed. Nothing here is secret — this app
# has no API keys, no auth tokens, and no database credentials.

# "api" (default) uses the FastAPI backend and the Bedrock-backed grant agent.
# "mock" remains available for frontend-only development when the backend is off.
VITE_API_MODE=api

# Backend origin. The frontend adapter appends the versioned /api/v1 paths.
VITE_API_URL=http://127.0.0.1:8000
APP_NAME=Grant Intelligence Backend
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true

# Required by the published agent when calling Claude through Amazon Bedrock.
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
