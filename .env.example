# Copy to .env.local and adjust as needed. Nothing here is secret — this app
# has no API keys, no auth tokens, and no database credentials.

# "mock" (default) uses MockGrantIntelligenceService — everything runs
# locally, no network requests are made. "api" switches to
# ApiGrantIntelligenceService, which talks to the future FastAPI backend
# below. That backend does not exist yet; setting VITE_API_MODE=api today
# will just point the app at endpoints that 404.
VITE_API_MODE=mock

# Base URL for the future FastAPI backend. Only read when VITE_API_MODE=api.
VITE_API_URL=http://localhost:8000
APP_NAME=Grant Intelligence Backend
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true
