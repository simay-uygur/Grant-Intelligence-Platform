# Copy to .env.local and adjust as needed. Nothing here is secret — this app
# has no API keys, no auth tokens, and no database credentials.

# "api" (default) uses the FastAPI backend and the Bedrock-backed grant agent.
# "mock" remains available for frontend-only development when the backend is off.
VITE_API_MODE=api

# Backend origin. The frontend adapter appends the versioned /api/v1 paths.
VITE_API_URL=http://127.0.0.1:8000
APP_NAME=Grant Intelligence Backend
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true

# Shared local SQLite database for chat history and stored applications.
SQLITE_DB_PATH=storage/backend.db

# Storage mode toggle: "local" (SQLite / browser storage) or "hosted" (RDS / Cloud Database)
SESSION_STORAGE_TYPE=local
# DATABASE_URL=postgresql://user:password@rds-instance-endpoint.us-east-1.rds.amazonaws.com:5432/grant_db

# Required by the published agent when calling Claude through Amazon Bedrock.
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
USE_MOCK_BEDROCK=false

# Set AUTH_REQUIRED=true for hosted deployments. Keep this secret private and random.
AUTH_REQUIRED=false
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_HOURS=168
