# Normalize line endings to LF in the repository, regardless of the
# checking-out machine's core.autocrlf setting. Windows checkouts with
# core.autocrlf=true otherwise leave text files with CRLF on disk, which
# eslint/prettier (configured for LF) flag as formatting errors.
* text=auto eol=lf

*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
